+DEFINE EVENT OVERWRITE notify_read ON TABLE conversation
+  WHEN $event = "UPDATE" AND $sp00ky_endpoint != NONE AND (
+    ($after.last_read_ms_a ?? 0) > ($before.last_read_ms_a ?? 0)
+    OR ($after.last_read_ms_b ?? 0) > ($before.last_read_ms_b ?? 0)
+  )
+  THEN {
+    LET $key = 'dm:' + <string> record::id($after.id);
+    FOR $side IN [
+      [$after.user_a, $before.last_read_ms_a ?? 0, $after.last_read_ms_a ?? 0],
+      [$after.user_b, $before.last_read_ms_b ?? 0, $after.last_read_ms_b ?? 0]
+    ] {
+      IF $side[2] > $side[1] {
+        LET $reader = $side[0];
+        LET $read_ms = $side[2];
+        UPDATE (SELECT VALUE id FROM notification WHERE recipient = $reader AND group_key = $key
+          AND state IN ['collecting', 'ready'] AND updated_ms <= $read_ms) SET state = 'seen', seen_ms = $read_ms;
+      };
+    };
+  }
