---
// src/pages/index.astro
// oxlint-disable-next-line no-unassigned-import
import '../styles/global.css';
import '../styles/landing.css';
import { Image, getImage } from 'astro:assets';
import heroLandscape from '../assets/munich-california-hero.png';
import heroPortrait from '../assets/munich-california-hero-mobile.png';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SyncArchitecture from '../components/SyncArchitecture.astro';
import { ScrollRevealText } from '../components/ScrollRevealText';
import NewsletterSignup from '../components/NewsletterSignup';
import { basePath } from '../config/nav';

const mobileHeroWidths = [480, 768, 940];
const mobileHeroSources = await Promise.all(
  mobileHeroWidths.map((width) => getImage({ src: heroPortrait, width, format: 'webp', quality: 85 }))
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="sp00ky - A SurrealDB native Sync Engine" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-render-blocking: load as `print` so the browser fetches without
         blocking first paint, then promote to `all` once it arrives. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content="sp00ky: The SurrealDB Native Real-Time Sync Engine" />
    <meta
      property="og:description"
      content="Build local-first, offline-ready applications with sp00ky. Use the power of SurrealDB to synchronize data instantly across devices."
    />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.site} />
    <meta property="twitter:title" content="sp00ky: The SurrealDB Native Real-Time Sync Engine" />
    <meta
      property="twitter:description"
      content="Build local-first, offline-ready applications with sp00ky. Use the power of SurrealDB to synchronize data instantly across devices."
    />
    <meta property="twitter:image" content={new URL('/social-card.png', Astro.site)} />
    <link rel="help" type="text/markdown" href="/llm.txt" title="LLM Info" />
    <title>sp00ky</title>
  </head>
  <body class="landing-page min-h-screen flex flex-col">
    <SiteNav activePath="/" />

    <main class="flex-1">
      <!-- HERO -->
      <div class="hero-scroll-shell">
      <section id="home" class="landscape-hero" aria-labelledby="hero-title">
        <picture>
          <source
            media="(max-width: 760px)"
            srcset={mobileHeroSources.map((source, i) => `${source.src} ${mobileHeroWidths[i]}w`).join(', ')}
            sizes="100vw"
            width={heroPortrait.width}
            height={heroPortrait.height}
          />
          <Image
            src={heroLandscape}
            alt="An imagined lake between Bavaria and California: Munich towers, an academic stone facade, the Golden Gate Bridge and Berkeley’s Campanile among alpine forests, with a little ghost on the shore."
            class="landscape-hero-art"
            widths={[768, 1280, 1672]}
            sizes="100vw"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
        </picture>
        <div class="landscape-hero-shade" aria-hidden="true"></div>

        <div class="landing-intro">
          <div class="landing-intro-copy">
            <h1 id="hero-title" class="hero-headline">
              Focus on Product.<br /><span class="accent">We Handle Sync.</span>
            </h1>

            <div class="hero-actions">
              <div class="hero-ctas">
                <a href={`${basePath}/docs`} class="hero-btn hero-btn-primary">Start building <span aria-hidden="true">↗</span></a>
                <a href="#architecture" class="hero-btn hero-btn-ghost">Explore the engine <span aria-hidden="true">↓</span></a>
              </div>

              <div class="hero-install">
                <span class="prompt">$</span>
                <span class="cmd">npx @spooky-sync/cli@canary create</span>
                <button class="copy-btn" id="hero-copy-btn" aria-label="Copy install command">
                  <svg
                    id="hero-copy-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                    <path d="M5 15 H4 a2 2 0 0 1 -2 -2 V4 a2 2 0 0 1 2 -2 h9 a2 2 0 0 1 2 2 v1"></path>
                  </svg>
                  <svg
                    id="hero-check-icon"
                    class="hidden"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 6 L9 17 l-5 -5"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
      </div>

      <!-- Local-first introduction and live demo -->
      <section class="pt-12 pb-16 md:pb-32">
        <div class="max-w-7xl mx-auto px-4">
          <ScrollRevealText
            client:visible
            className="text-balance text-4xl md:text-6xl font-medium leading-[1.05] tracking-[-0.045em]"
            segments={[
              { text: "It's", preRevealed: true },
              {
                text: 'sp00ky.',
                preRevealed: true,
                className: 'font-serif font-normal italic tracking-tight text-text-secondary',
              },
              {
                text: 'Data changes, every screen updates. Reactive queries keep every tab, every device, and every user in sync, instantly.',
              },
            ]}
          />
        </div>

        <!-- Try Out Now, card style -->
        <div class="max-w-7xl mx-auto px-4 mt-16 md:mt-24">
          <div class="try-out-btn group relative rounded-2xl border border-white/[0.08] bg-[#111318] overflow-hidden cursor-pointer transition-all duration-300 hover:border-white/[0.14]">
            <div class="flex flex-col md:flex-row items-stretch min-h-[200px]">
              <div class="relative z-10 flex flex-col justify-between p-8 md:p-10 md:w-[45%]">
                <div>
                  <h3 class="text-xl font-semibold text-white/90 mb-2">Experimental Demo</h3>
                  <p class="text-sm text-white/40 leading-relaxed max-w-[260px]">
                    Explore a live app built with sp00ky. Powered by CRDTs, file buckets, and real-time sync.
                  </p>
                </div>
                <div class="mt-6">
                  <span class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white/70 rounded-lg border border-white/[0.1] bg-white/[0.04] group-hover:bg-white/[0.08] group-hover:text-white group-hover:border-white/[0.18] transition-all duration-300">
                    Try it now
                    <svg
                      class="w-3.5 h-3.5 -rotate-[0deg] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"></path>
                    </svg>
                  </span>
                </div>
              </div>
              <div class="relative flex-1 min-h-[160px] md:min-h-0">
                <div class="absolute inset-0 tryout-grid opacity-[0.35]"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="flex flex-col items-center gap-5 opacity-40 group-hover:opacity-60 transition-opacity duration-500">
                    <img src="/logo.svg" alt="sp00ky" class="w-40 md:w-48" />
                    <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-white/50">threads demo</span>
                  </div>
                </div>
                <div class="hidden md:flex absolute right-0 top-0 bottom-0 w-10 items-center justify-center">
                  <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-white/15 whitespace-nowrap" style="writing-mode: vertical-rl;">Experimental Preview</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <SyncArchitecture />

      <!-- CTA SECTION -->
      <section class="launch-section relative overflow-hidden bg-black py-28 md:py-44">
        <div class="launch-atmosphere" aria-hidden="true">
        <!-- ASCII animation background (file is pre-baked ping-pong, so a plain loop suffices)
             Constrained to roughly the form width + 100px and centered, with a feathered fade
             so the edges blend into the section instead of cutting hard. -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
          style="
            width: min(748px, 92vw);
            aspect-ratio: 1 / 1;
            -webkit-mask-image: radial-gradient(closest-side, black 55%, transparent 100%);
            mask-image: radial-gradient(closest-side, black 55%, transparent 100%);
          "
        >
          <video
            class="h-full w-full object-cover opacity-30 mix-blend-screen"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
          >
            <source src="/ascii-animation.mp4" type="video/mp4" />
          </video>
        </div>

        <!-- Spotlight halo -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 top-0 flex justify-center"
        >
          <div
            class="h-[640px] w-[1100px] max-w-[120vw] -translate-y-[35%] rounded-full"
            style="background: radial-gradient(closest-side, rgba(255,255,255,0.10), rgba(124,106,239,0.06) 38%, transparent 72%);"
          >
          </div>
        </div>

        </div>
        <div
          class="relative z-10 mx-auto max-w-xl px-6 text-center"
          style="text-shadow: 0 1px 2px rgba(0,0,0,0.6), 0 0 18px rgba(0,0,0,0.45);"
        >
          <h2
            class="mb-6 text-balance text-5xl font-medium tracking-[-0.04em] text-white md:text-7xl"
            style="text-shadow: 0 2px 4px rgba(0,0,0,0.6), 0 0 32px rgba(0,0,0,0.55);"
          >
            Almost <span class="font-serif font-normal italic tracking-tight text-white/90"
              >ready.</span
            >
          </h2>

          <p
            class="mx-auto mb-12 max-w-md text-balance text-base leading-relaxed text-text-secondary md:text-[17px]"
          >
            We're putting the finishing touches on sp00ky. Drop your email and you'll be first
            through the door.
          </p>

          <NewsletterSignup client:load />

          <p class="mt-4 font-mono text-[11px] tracking-wide text-text-tertiary">
            // no spam, one note when beta opens
          </p>

          <div class="mt-16 flex items-center justify-center">
            <a
              href={`${basePath}/docs`}
              class="group inline-flex items-center gap-1.5 text-xs text-text-secondary transition-colors hover:text-text-primary"
            >
              <span>Or dive into the docs while we cook</span>
              <svg
                class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.25"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <!-- Try Out Now fullscreen iframe overlay -->
    <div id="tryout-overlay" class="fixed inset-0 z-[100] hidden">
      <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" id="tryout-backdrop"></div>
      <div class="relative z-10 flex flex-col w-full h-full p-3 md:p-6">
        <div class="flex justify-end mb-2">
          <button
            id="tryout-close"
            class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-text-tertiary hover:text-white bg-white/10 hover:bg-white/20 rounded-lg transition-all duration-200"
            aria-label="Close demo"
          >
            <span>Close</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <iframe
          id="tryout-iframe"
          class="flex-1 w-full rounded-xl border border-white/10 bg-black"
          title="sp00ky Demo"
          allowfullscreen
        ></iframe>
        <!-- Shown instead of the iframe while the demo host is unreachable. A
             visitor seeing our own "temporarily unavailable" note is far better
             than one seeing a browser-level security warning. -->
        <div
          id="tryout-unavailable"
          class="hidden flex-1 w-full rounded-xl border border-white/10 bg-black items-center justify-center p-8"
        >
          <div class="max-w-md text-center">
            <h3 class="text-lg font-semibold text-white mb-2">The live demo is temporarily offline</h3>
            <p class="text-sm text-text-tertiary mb-6">
              We're restoring it. In the meantime you can run the same app locally in about a
              minute.
            </p>
            <code class="inline-block px-3 py-2 rounded-lg bg-white/10 text-sm text-white"
              >npx @spooky-sync/cli@canary create</code
            >
          </div>
        </div>
      </div>
    </div>

    <script>
      // Hero install copy button
      const copyBtn = document.getElementById('hero-copy-btn');
      const copyIcon = document.getElementById('hero-copy-icon');
      const checkIcon = document.getElementById('hero-check-icon');
      if (copyBtn && copyIcon && checkIcon) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('npx @spooky-sync/cli@canary create');
          } catch {
            /* ignore */
          }
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }, 1600);
        });
      }

      // Try sp00ky overlay
      //
      // The demo host is named once, here. `DEMO_ENABLED` is the switch to flip
      // when the demo cannot be embedded — currently Cloudflare serves a
      // "Suspected Phishing" interstitial for this hostname, so embedding it
      // would show every visitor a security warning inside our own page. Flip
      // back to true once that clears (or once the demo moves to a hostname
      // with real reputation, which is the durable fix).
      const DEMO_URL = 'https://threads.stg.spky.cloud/';
      const DEMO_ENABLED = false;

      const overlay = document.getElementById('tryout-overlay');
      const iframe = document.getElementById('tryout-iframe') as HTMLIFrameElement;
      const unavailable = document.getElementById('tryout-unavailable');
      const closeBtn = document.getElementById('tryout-close');
      const backdrop = document.getElementById('tryout-backdrop');

      function openTryout() {
        if (!overlay || !iframe) return;
        if (DEMO_ENABLED) {
          iframe.src = DEMO_URL;
          iframe.classList.remove('hidden');
          unavailable?.classList.add('hidden');
        } else {
          iframe.classList.add('hidden');
          unavailable?.classList.remove('hidden');
          unavailable?.classList.add('flex');
        }
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeTryout() {
        if (!overlay || !iframe) return;
        overlay.classList.add('hidden');
        iframe.src = '';
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.try-out-btn').forEach((btn) => {
        btn.addEventListener('click', openTryout);
      });

      closeBtn?.addEventListener('click', closeTryout);
      backdrop?.addEventListener('click', closeTryout);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeTryout();
      });

    </script>
  </body>

  <script>
    // Animated favicon (floating ghost). Skipped on Safari. Its
    // canvas.toDataURL() takes ~100ms per call, which pegs CPU at 100%
    // and causes multi-second main-thread freezes. The static SVG favicon
    // in <head> remains the fallback there.
    const ua = navigator.userAgent;
    const isSafari =
      /^((?!chrome|android|crios|fxios|edgios).)*safari/i.test(ua) &&
      navigator.vendor === 'Apple Computer, Inc.';

    if (!isSafari) {
      const ghostSVG = `
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none">
        <style>
          .bg { fill: #FFFFFF; }
          .ghost { fill: #000000; }
          .eyes { fill: #FFFFFF; }
          @media (prefers-color-scheme: dark) {
            .bg { fill: #000000; }
            .ghost { fill: #FFFFFF; }
            .eyes { fill: #000000; }
          }
        </style>
        <path class="ghost" d="M6 10V28L10 24L14 28L18 24L22 28L26 24V10C26 4.47715 21.5228 0 16 0C10.4772 0 6 4.47715 6 10Z"/>
        <rect class="eyes" x="10" y="8" width="4" height="4"/>
        <rect class="eyes" x="18" y="8" width="4" height="4"/>
      </svg>`;

      const canvas = document.createElement('canvas');
      canvas.width = 32;
      canvas.height = 32;
      const ctx = canvas.getContext('2d');

      const img = new Image();
      img.src = 'data:image/svg+xml;base64,' + btoa(ghostSVG);

      let link = document.querySelector("link[rel~='icon']") as HTMLLinkElement;
      if (!link) {
        link = document.createElement('link');
        link.rel = 'icon';
        document.head.appendChild(link);
      }

      img.addEventListener('load', function () {
        const start = performance.now();
        function step(timestamp: number) {
          const elapsed = timestamp - start;
          const yOffset = (1 - Math.cos((elapsed / 3000) * 2 * Math.PI)) * 1.5;
          ctx?.clearRect(0, 0, 32, 32);
          ctx?.drawImage(img, 0, yOffset, 32, 32);
          link.href = canvas.toDataURL('image/png');
          requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }
  </script>

  <style>
    /* Try Out Now, grid pattern */
    .tryout-grid {
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 40px 40px;
    }
  </style>
</html>
