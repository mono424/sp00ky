;

DEFINE EVENT OVERWRITE collection_tree_cleanup ON TABLE game_database
  WHEN $event = "DELETE" AND $sp00ky_endpoint != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    UPDATE (SELECT VALUE id FROM collection_tree WHERE database = $before_id) SET requested = (requested ?? 0) + 1;
  }
;

DEFINE EVENT OVERWRITE database_players_club_mirror ON TABLE game_database
  WHEN $event = "UPDATE" AND $before.club != $after.club AND $sp00ky_endpoint != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_id = $after.id;
    IF $after.club = NONE {
      UPDATE (SELECT VALUE id FROM database_players WHERE database = $after_id) UNSET club;
    } ELSE {
      UPDATE (SELECT VALUE id FROM database_players WHERE database = $after_id) SET club = $after.club;
    };
  }
;

DEFINE EVENT OVERWRITE game_children_cleanup ON TABLE game
  WHEN $event = "DELETE" AND $sp00ky_endpoint != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM analysis WHERE game = $before_id);
    DELETE (SELECT VALUE id FROM game_insight WHERE game = $before_id);
    DELETE (SELECT VALUE id FROM comment WHERE game = $before_id);
    DELETE (SELECT VALUE id FROM branch WHERE game = $before_id);
    DELETE (SELECT VALUE id FROM annotation WHERE game = $before_id);
    DELETE (SELECT VALUE id FROM commented_on WHERE out = $before_id);
  }
;

DEFINE EVENT OVERWRITE game_database_club_must_be_staff ON TABLE game_database
  WHEN ( $event = "CREATE" OR ( $event = "UPDATE" AND $before.club != $after.club ) ) AND $sp00ky_endpoint != NONE AND $auth != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_club = $after.club;
    IF $after.club != NONE AND !( $after.club.owner = $auth.id OR $auth.id IN (SELECT VALUE user FROM club_member WHERE club = $after_club AND role = 'admin' AND approved = true AND accepted = true) ) {
      THROW "not a club admin";
    };
  }
;

DEFINE EVENT OVERWRITE inventory_board_sticker ON TABLE inventory_item
  WHEN $event = "CREATE" AND $sp00ky_endpoint != NONE AND string::starts_with($after.item, "board_")
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_owner = $after.owner;
    LET $touched = (SELECT VALUE id FROM inventory_item WHERE owner = $after_owner AND on_card != NONE LIMIT 1);
    IF array::len($touched) = 0 {
      UPDATE (SELECT VALUE id FROM inventory_item WHERE owner = $after_owner AND string::starts_with(item, "plan_")) SET on_card = true RETURN NONE;
    };
    UPDATE $after.id SET on_card = true, detail = IF string::matches($after.detail ?? "", "^(Chessnut|DGT) [A-Za-z0-9+-]+$") { $after.detail } ELSE { NONE } RETURN NONE;
    CREATE email_job CONTENT {
      path: "/jobs/notify-sticker",
      payload: { item: <string> $after.id },
      status: "pending"
    };
  }
;

DEFINE EVENT OVERWRITE inventory_plan_sticker ON TABLE user
  WHEN $sp00ky_endpoint != NONE AND ($event = "DELETE" OR ($before.plan ?? "free") != ($after.plan ?? "free"))
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    LET $after_id = $after.id;
    IF $event = "DELETE" {
      DELETE (SELECT VALUE id FROM inventory_item WHERE owner = $before_id) RETURN NONE;
    } ELSE {
      FOR $tier IN ["pro", "creator"] {
        LET $item = string::concat("plan_", $tier);
        LET $id = type::record("inventory_item", string::concat(<string> record::id($after.id), "_", $item));
        IF $after.plan = $tier {
          IF !record::exists($id) {
            LET $touched = (SELECT VALUE id FROM inventory_item WHERE owner = $after_id AND on_card != NONE LIMIT 1);
            CREATE $id CONTENT { owner: $after.id, item: $item, acquired_at: time::now(), on_card: IF array::len($touched) > 0 { true } ELSE { NONE } } RETURN NONE;
          };
        } ELSE {
          DELETE $id RETURN NONE;
        };
      };
    };
  }
;

DEFINE EVENT OVERWRITE notify_read ON TABLE conversation
  WHEN $event = "UPDATE" AND $sp00ky_endpoint != NONE AND (
    ($after.last_read_ms_a ?? 0) > ($before.last_read_ms_a ?? 0)
    OR ($after.last_read_ms_b ?? 0) > ($before.last_read_ms_b ?? 0)
  )
  THEN {
    LET $key = 'dm:' + <string> record::id($after.id);
    FOR $side IN [
      [$after.user_a, $before.last_read_ms_a ?? 0, $after.last_read_ms_a ?? 0],
      [$after.user_b, $before.last_read_ms_b ?? 0, $after.last_read_ms_b ?? 0]
    ] {
      IF $side[2] > $side[1] {
        LET $reader = $side[0];
        LET $read_ms = $side[2];
        UPDATE (SELECT VALUE id FROM notification WHERE recipient = $reader AND group_key = $key
          AND state IN ['collecting', 'ready'] AND updated_ms <= $read_ms) SET state = 'seen', seen_ms = $read_ms;
      };
    };
  }
;

DEFINE EVENT OVERWRITE pgn_import_enqueue ON TABLE pgn_import
  WHEN $sp00ky_endpoint != NONE AND ($event = "CREATE" OR $event = "UPDATE") AND $after.status = "uploaded" AND ($event = "CREATE" OR $before.status != "uploaded")
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_id_str = <string> $after.id;
    IF array::len(SELECT VALUE id FROM job WHERE path = "/importPgn" AND payload.import = $after_id_str AND status IN ["pending", "processing"]) = 0 {
      CREATE job CONTENT { path: "/importPgn", payload: { import: <string> $after.id }, status: "pending" };
    };
  }
;

DEFINE EVENT OVERWRITE puzzle_progress_chapter_fill ON TABLE puzzle_progress
  WHEN $sp00ky_endpoint != NONE AND $event = "CREATE" AND $after.chapter = NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_puzzle = $after.puzzle;
    LET $after_lecture = $after.lecture;
    LET $c = (SELECT VALUE chapter FROM puzzle_lecture WHERE puzzle = $after_puzzle AND key = $after_lecture LIMIT 1)[0];
    IF $c != NONE {
      UPDATE $after.id SET chapter = $c;
    };
  }
;

DEFINE EVENT OVERWRITE puzzle_rating_replies_cleanup ON TABLE puzzle_rating
  WHEN $sp00ky_endpoint != NONE AND $event = "DELETE"
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM puzzle_rating_reply WHERE rating = $before_id);
  }
;

DEFINE EVENT OVERWRITE puzzle_reconcile_enqueue ON TABLE puzzle
  WHEN $sp00ky_endpoint != NONE AND (($event = "CREATE" AND $after.layout = NONE AND $after.copy_from = NONE) OR ($event = "UPDATE" AND $after.content != $before.content AND $after.content_rev = $before.content_rev) OR ($event = "UPDATE" AND $auth != NONE AND $after.layout = "rows" AND ($before.layout != "rows" OR $after.title != $before.title OR $after.description != $before.description OR $after.cover_key != $before.cover_key)))
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_id_str = <string> $after.id;
    IF array::len(SELECT VALUE id FROM job WHERE status = "pending" AND path = "/puzzleReconcile" AND payload.puzzle = $after_id_str) = 0 {
      CREATE job CONTENT { path: "/puzzleReconcile", payload: { puzzle: <string> $after.id }, status: "pending", delay: IF $after.importing = true THEN 0 ELSE 30000 END };
    };
  }
;

DEFINE EVENT OVERWRITE puzzle_replies_cleanup ON TABLE puzzle
  WHEN $sp00ky_endpoint != NONE AND $event = "DELETE"
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM puzzle_rating_reply WHERE puzzle = $before_id);
  }
;

DEFINE EVENT OVERWRITE scene_template_mirror ON TABLE scene_template
  WHEN $sp00ky_endpoint != NONE AND $event = "UPDATE" AND $after.scenes != NONE AND $before.scenes != $after.scenes
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_id = $after.id;
    INSERT INTO broadcast_scenes (
      SELECT type::record('broadcast_scenes', record::id(owner)) AS id, owner, $after.scenes AS scenes
      FROM broadcast WHERE template = $after_id AND ended_at = NONE
    ) ON DUPLICATE KEY UPDATE scenes = $input.scenes;
  };

DEFINE EVENT OVERWRITE skins_user_delete ON TABLE user
  WHEN $sp00ky_endpoint != NONE AND $event = "DELETE"
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM piece_skin WHERE owner = $before_id) RETURN NONE;
    DELETE (SELECT VALUE id FROM skin_case WHERE owner = $before_id) RETURN NONE;
    DELETE (SELECT VALUE id FROM pack_gift WHERE owner = $before_id) RETURN NONE;
    DELETE (SELECT VALUE id FROM trade_holder WHERE owner = $before_id) RETURN NONE;
    DELETE (SELECT VALUE id FROM trade_offer WHERE sender = $before_id) RETURN NONE;
    DELETE (SELECT VALUE id FROM trade_offer WHERE receiver = $before_id) RETURN NONE;
  }
;

DEFINE EVENT OVERWRITE statistics_cleanup ON TABLE game_database
  WHEN $event = "DELETE"
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM statistics WHERE database = $before_id);
    DELETE (SELECT VALUE id FROM database_players WHERE database = $before_id);
  }
;

DEFINE EVENT OVERWRITE statistics_enqueue ON TABLE game
  WHEN ($event = "CREATE" OR $event = "DELETE" OR $event = "UPDATE") AND $sp00ky_endpoint != NONE AND ($after.owner ?? $before.owner) != user:scout AND NOT ($event != "DELETE" AND $after.status = "Recording" AND ($event = "CREATE" OR $before.status = "Recording"))
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_database = $after.database;
    LET $bookkeeping = ["insights_computed_at", "insights_error", "insights_attempts", "insights_next_attempt_at", "cloud_analysis_held_until"];
    IF $event = "UPDATE" AND object::remove($before, $bookkeeping) = object::remove($after, $bookkeeping) {
      IF ($before.insights_computed_at = NONE) != ($after.insights_computed_at = NONE) {
        LET $n = (SELECT VALUE count() FROM game WHERE database = $after_database AND insights_computed_at != NONE GROUP ALL)[0] ?? 0;
        UPDATE (SELECT VALUE id FROM statistics WHERE database = $after_database) SET analyzed_count = $n;
      };
    } ELSE {
      -- A game deleted after its collection or its account is already gone (the
      -- paced /cleanup-collection and /cleanup-account jobs in apps/analytics-api)
      -- has nothing left to recompute: the aggregates die with the collection.
      -- Before this guard, deleting a large collection queued one full recompute
      -- of the dead collection per deleted game. An IF/THEN expression, so
      -- record::exists never sees the NONE $before of a CREATE: a function error
      -- inside this event aborts the game write.
      LET $gone = IF $event = "DELETE" THEN (!record::exists($before.database) OR !record::exists($before.owner)) ELSE false END;
      IF !$gone {
        LET $bd = IF $event != "CREATE" THEN $before.database ELSE NONE END;
        LET $ad = IF $event != "DELETE" THEN $after.database ELSE NONE END;
        FOR $coll IN array::distinct([$bd, $ad]) {
          IF $coll != NONE {
            IF array::len(SELECT VALUE id FROM statistics_job WHERE assigned_to = $coll AND status = "pending" AND payload.contacts != true) = 0 {
              CREATE statistics_job CONTENT {
                assigned_to: $coll,
                path: "/recompute",
                payload: { database: <string> $coll },
                status: "pending"
              };
            };
          };
        };
      };
    };
  }
;

-- Single-column indexes for the lookups the events above make: inside an event
-- body SurrealDB 4.0.1 does not use a composite index for a parameter, whichever
-- of its columns the WHERE matches. Built concurrently: analysis holds millions of rows.
DEFINE INDEX IF NOT EXISTS analysis_game ON TABLE analysis FIELDS game CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS statistics_database ON TABLE statistics FIELDS database CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS notification_recipient ON TABLE notification FIELDS recipient CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS database_players_club ON TABLE database_players FIELDS club CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS statistics_owner ON TABLE statistics FIELDS owner CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS collection_share_collection ON TABLE collection_share FIELDS collection CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS activity_day_database ON TABLE activity_day FIELDS database CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS puzzle_lecture_puzzle ON TABLE puzzle_lecture FIELDS puzzle CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS broadcast_share_broadcast ON TABLE broadcast_share FIELDS broadcast CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS broadcast_eval_broadcast ON TABLE broadcast_eval FIELDS broadcast CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS stream_recording_segment_by_recording ON TABLE stream_recording_segment FIELDS recording CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS stream_recording_part_by_recording ON TABLE stream_recording_part FIELDS recording CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS club_event_club ON TABLE club_event FIELDS club CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS club_post_club ON TABLE club_post FIELDS club CONCURRENTLY;
DEFINE INDEX IF NOT EXISTS club_post_comment_post ON TABLE club_post_comment FIELDS post CONCURRENTLY;

-- `FOR select WHERE true` is the same rule as `FOR select FULL`, but SurrealDB 4.0.1
-- plans the two differently for a record user: with any select rule other than FULL
-- it gives up the table's indexes for a query the user's write runs through an event
-- (a game delete by its owner read all 11.45M analysis rows: 37-115 s; 0.2-0.5 s with
-- FULL), and with a non-FULL rule on a filtered field even for the user's own query.

DEFINE TABLE OVERWRITE user SCHEMAFULL
PERMISSIONS
  FOR update, delete, create WHERE $access IN ["account", "_00_impersonate"] AND id = $auth.id AND ($auth.session_epoch = NONE OR ($token.iat ?? 0) >= $auth.session_epoch)
  FOR select FULL;

DEFINE FIELD OVERWRITE email ON TABLE user TYPE string
ASSERT $value != NONE -- AND string::is_email($value) -- NOT COMPATIBLE RIGHT NOW
PERMISSIONS
    FOR select FULL
    FOR update WHERE $access = "account" AND id = $auth.id;

DEFINE FIELD OVERWRITE public_key ON TABLE user TYPE option<string> PERMISSIONS FOR select FULL FOR create, update WHERE false;

DEFINE FIELD OVERWRITE plan ON TABLE user TYPE option<string> PERMISSIONS FOR select FULL FOR update WHERE false;

DEFINE TABLE OVERWRITE game_database SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
    FOR update WHERE $access IN ["account", "_00_impersonate"] AND ( owner = $auth.id OR id IN (SELECT VALUE collection FROM collection_share WHERE user = $auth.id AND role = 'editor') OR club IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) )
;

DEFINE TABLE OVERWRITE game SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR update, delete, create WHERE $access IN ["account", "_00_impersonate"] AND ( owner = $auth.id OR database.owner = $auth.id OR database IN (SELECT VALUE collection FROM collection_share WHERE user = $auth.id AND role = 'editor') )
;

DEFINE FIELD OVERWRITE skins ON TABLE game TYPE option<array<string>> PERMISSIONS FOR select FULL FOR create, update WHERE $access NOT IN ["account", "_00_impersonate"] OR $value = NONE OR array::len(array::complement(array::distinct($value.map(|$e| string::split($e, ":")[1])), (SELECT VALUE skin FROM piece_skin WHERE owner = $auth.id))) = 0;

DEFINE TABLE OVERWRITE puzzle SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR update, delete, create WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
;

DEFINE TABLE OVERWRITE puzzle_chapter SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
;

DEFINE TABLE OVERWRITE puzzle_lecture SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
;

DEFINE TABLE OVERWRITE puzzle_facet SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE false
;

DEFINE TABLE OVERWRITE player_name SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create WHERE $access IN ["account", "_00_impersonate"] AND author = $auth.id
    FOR update, delete NONE
;

DEFINE TABLE OVERWRITE profile_stats SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE false
;

DEFINE TABLE OVERWRITE activity_day SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE $access IN ["account", "_00_impersonate"] AND ( owner = $auth.id OR database.owner = $auth.id OR database IN (SELECT VALUE collection FROM collection_share WHERE user = $auth.id AND role = 'editor') )
;

DEFINE TABLE OVERWRITE broadcast SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
    FOR update WHERE $access IN ["account", "_00_impersonate"] AND ( owner = $auth.id OR id IN (SELECT VALUE broadcast FROM broadcast_share WHERE user = $auth.id AND role = 'admin') OR club IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) )
;

DEFINE FIELD OVERWRITE owner ON TABLE battery_warning TYPE record<user> PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE TABLE OVERWRITE inventory_item SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id AND item IN ["board_dgt", "board_chessnut"] AND record::id(id) = string::concat(<string> record::id($auth.id), "_", item)
    FOR update WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
    FOR delete WHERE false
;

DEFINE FIELD OVERWRITE owner ON TABLE inventory_item TYPE record<user> PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE FIELD OVERWRITE item ON TABLE inventory_item TYPE string PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE FIELD OVERWRITE acquired_at ON TABLE inventory_item TYPE datetime PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE FIELD OVERWRITE detail ON TABLE inventory_item TYPE option<string> PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE TABLE OVERWRITE piece_skin SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create WHERE false
    FOR update WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
    FOR delete WHERE false
;

DEFINE FIELD OVERWRITE owner ON TABLE piece_skin TYPE record<user> PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE FIELD OVERWRITE skin ON TABLE piece_skin TYPE string PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE FIELD OVERWRITE piece ON TABLE piece_skin TYPE string PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE FIELD OVERWRITE side ON TABLE piece_skin TYPE string PERMISSIONS FOR select, create FULL FOR update WHERE false;

DEFINE FIELD OVERWRITE source ON TABLE piece_skin TYPE record<skin_case> PERMISSIONS FOR select, create FULL FOR update WHERE false;

