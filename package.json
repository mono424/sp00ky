{
  "name": "sp00ky",
  "version": "0.0.1-canary.244",
  "private": true,
  "description": "Sp00ky monorepo",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:example": "pnpm --filter @example/project dev",
    "dev:example:clean": "pnpm --filter @example/project dev:clean",
    "dev:example:reset": "pnpm --filter @example/project dev:reset",
    "dev:web": "pnpm --filter @example/app-solid dev",
    "dev:landingpage": "pnpm --filter landing-page dev:landingpage",
    "dev:build": "cargo build -p sp00ky-cli -p ssp-server -p scheduler",
    "dev:images": "pnpm --filter ssp build && pnpm --filter scheduler build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:oxc": "oxlint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "skills:validate": "pnpm --filter @spooky-sync/query-builder exec npx @tanstack/intent validate skills && pnpm --filter @spooky-sync/core exec npx @tanstack/intent validate skills && pnpm --filter @spooky-sync/client-solid exec npx @tanstack/intent validate skills && pnpm --filter @spooky-sync/client-solid2 exec npx @tanstack/intent validate skills"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.21.1"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.0.21",
    "prettier": "^3.7.4",
    "surrealdb": "2.0.3"
  }
}
