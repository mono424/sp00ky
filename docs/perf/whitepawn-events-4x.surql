-- The outbox tables (packages/schema/src/outbox), same rule:

DEFINE FIELD OVERWRITE assigned_to ON TABLE broadcast_job TYPE record<broadcast>
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE path ON TABLE broadcast_job TYPE string
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE payload ON TABLE broadcast_job TYPE any
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE retries ON TABLE broadcast_job TYPE int DEFAULT ALWAYS 0
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE retry_strategy ON TABLE broadcast_job TYPE string DEFAULT ALWAYS "linear"
ASSERT $value IN ["linear", "exponential"]
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE status ON TABLE broadcast_job TYPE string DEFAULT ALWAYS "pending"
ASSERT $value IN ["pending", "processing", "success", "failed"]
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE updated_at ON TABLE broadcast_job TYPE datetime
DEFAULT ALWAYS time::now()
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE created_at ON TABLE broadcast_job TYPE datetime
VALUE time::now()
PERMISSIONS
  FOR create, select FULL
  FOR update WHERE false;

DEFINE FIELD OVERWRITE assignee ON TABLE broadcast_job TYPE option<string>
PERMISSIONS
  FOR select FULL
  FOR create, update WHERE false;

