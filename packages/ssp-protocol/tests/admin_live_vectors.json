    "patch": {"append": [{"t": 4}, {"t": 5}]}
  },
  {
    "name": "series: going backwards needs a snapshot",
    "shape": "series",
    "key": "t",
    "prev": {"items": [{"t": 5}, {"t": 6}], "keep": 10, "meta": {}},
    "next": {"items": [{"t": 1}], "keep": 10, "meta": {}},
    "patch": "reset"
