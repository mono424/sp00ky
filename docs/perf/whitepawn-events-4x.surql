-- WhitePawn's app events rewritten so SurrealDB 4.0.1 plans their statements as index reads
-- (the shapes 3.3.5 plans the same way). Generated by sp00ky's perf/sdb4-parity work from
-- whitepawn 1e3e3e22 packages/schema/src/schema.surql; same statements in the same order:
--   * event values used in a WHERE are bound with LET at the top of the body;
--   * UPDATE/DELETE <table> ... WHERE ... -> UPDATE/DELETE (SELECT VALUE id FROM <table> WHERE ...).
-- Apply as a migration (DEFINE EVENT OVERWRITE is idempotent).

DEFINE EVENT OVERWRITE activity_day_cleanup ON TABLE game_database
  WHEN $event = "DELETE"
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM activity_day WHERE database = $before_id);
  }
;

DEFINE EVENT OVERWRITE broadcast_children_cleanup ON TABLE broadcast
  WHEN $event = "DELETE" AND $sp00ky_endpoint != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    LET $recording = type::record('stream_recording', record::id($before.id));
    DELETE (SELECT VALUE id FROM chat_message WHERE broadcast = $before_id);
    DELETE (SELECT VALUE id FROM broadcast_share WHERE broadcast = $before_id);
    DELETE (SELECT VALUE id FROM broadcast_eval WHERE broadcast = $before_id);
    DELETE (SELECT VALUE id FROM stream_recording_segment WHERE recording = $recording);
    DELETE (SELECT VALUE id FROM stream_recording_part WHERE recording = $recording);
    UPDATE (SELECT VALUE id FROM stream_recording WHERE broadcast = $before_id) SET status = 'deleted';
    UPDATE (SELECT VALUE id FROM game WHERE broadcast = $before_id AND broadcast_detached != true) SET broadcast_detached = true;
  }
;

DEFINE EVENT OVERWRITE broadcast_club_must_be_staff ON TABLE broadcast
  WHEN ( $event = "CREATE" OR ( $event = "UPDATE" AND $before.club != $after.club ) ) AND $sp00ky_endpoint != NONE AND $auth != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $after_club = $after.club;
    IF $after.club != NONE AND !( $after.club.owner = $auth.id OR $auth.id IN (SELECT VALUE user FROM club_member WHERE club = $after_club AND role = 'admin' AND approved = true AND accepted = true) ) {
      THROW "not a club admin";
    };
  }
;

DEFINE EVENT OVERWRITE chesscom_flag_plan ON TABLE user
  WHEN $sp00ky_endpoint != NONE AND ($event = "DELETE" OR ($before.plan ?? "free") != ($after.plan ?? "free"))
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    IF array::len((SELECT VALUE id FROM _00_feature_flag WHERE key = "chesscom" LIMIT 1)) > 0 {
      IF $event = "DELETE" {
        LET $uid = <string> $before.id;
        UPDATE (SELECT VALUE id FROM _00_feature_flag WHERE key = "chesscom") SET rules = array::map(rules ?? [], |$r| {
          RETURN IF $r.kind = "allowlist" {
            { kind: "allowlist", variant: $r.variant, users: array::filter(array::map($r.users ?? [], |$x| <string> $x), |$x| $x != $uid), priority: $r.priority ?? 10 }
          } ELSE { $r };
        }) RETURN NONE;
        DELETE (SELECT VALUE id FROM _00_user_feature WHERE user = $before_id AND key = "chesscom") RETURN NONE;
      } ELSE IF $after.plan IN ["pro", "creator"] {
        fn::feature::allow("chesscom", "on", $after.id);
      } ELSE {
        fn::feature::disallow("chesscom", $after.id);
      };
    };
  }
;

DEFINE EVENT OVERWRITE club_children_cleanup ON TABLE club
  WHEN $event = "DELETE" AND $sp00ky_endpoint != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM event_signup WHERE club = $before_id);
    DELETE (SELECT VALUE id FROM club_event WHERE club = $before_id);
    DELETE (SELECT VALUE id FROM club_post_comment WHERE club = $before_id);
    DELETE (SELECT VALUE id FROM club_post WHERE club = $before_id);
    DELETE (SELECT VALUE id FROM club_member WHERE club = $before_id);
    UPDATE (SELECT VALUE id FROM game_database WHERE club = $before_id) UNSET club;
    UPDATE (SELECT VALUE id FROM broadcast WHERE club = $before_id) UNSET club;
    UPDATE (SELECT VALUE id FROM database_players WHERE club = $before_id) UNSET club;
  }
;

