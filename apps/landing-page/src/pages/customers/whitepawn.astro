---
// oxlint-disable-next-line no-unassigned-import
import '../../styles/global.css';
import '../../styles/case-study.css';
import { Image } from 'astro:assets';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeCard from '../../components/case-study/CodeCard.astro';
import SyncDemo from '../../components/case-study/SyncDemo';
import { basePath } from '../../config/nav';
import heroArt from '../../assets/case-studies/whitepawn/hero.webp';
import studioArt from '../../assets/case-studies/whitepawn/studio.webp';
import togetherArt from '../../assets/case-studies/whitepawn/analyze-together-sketch.webp';
import portalShot from '../../assets/case-studies/whitepawn/web-portal.png';

// Every number on this page comes from WhitePawn's repository or its production
// admin API, as of 2026-09-30. Where a number is a count of call sites, it was
// taken with grep over apps/solid-app/src (generated files and tests excluded).

const title = 'WhitePawn case study';
const description =
  'How one developer ships a real-time chess platform to web, iOS and Android on sp00ky: 79 tables, 178 live queries, 16 services and no hand-written API layer.';

// ---------------------------------------------------------------------------
// The build, in the order a feature is built. Code is copied from WhitePawn,
// trimmed (marked with ...) but not rewritten.
// ---------------------------------------------------------------------------

type Snippet = { file: string; lang: string; code: string };
type Step = { title: string; body: string[]; saved: string; code: Snippet[] };

const steps: Step[] = [
  {
    title: 'Describe the data once, with its rules',
    body: [
      'Every WhitePawn feature starts in one SurrealQL schema: 79 tables, each with its permissions next to its fields. Direct messages are a good example. Only the two people in a conversation can read a message, only the sender can write or delete it, and nobody can edit it.',
      'Those same rules decide what each user\'s live queries return. There is no second copy of them in an API handler.',
      'One config line per platform turns the schema into typed models for the web app and the Flutter app.',
    ],
    saved: 'No REST or GraphQL layer, no permission checks repeated in handlers, no models kept in step by hand across TypeScript and Dart.',
    code: [
      {
        file: 'packages/schema/src/schema.surql',
        lang: 'surrealql',
        code: `DEFINE TABLE message SCHEMAFULL
  PERMISSIONS
    FOR select WHERE $access IN ["account", "_00_impersonate"] AND ( sender = $auth.id OR recipient = $auth.id )
    FOR create WHERE $access IN ["account", "_00_impersonate"] AND sender = $auth.id AND recipient != $auth.id
    FOR update WHERE false
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND sender = $auth.id
;

DEFINE FIELD conversation ON TABLE message TYPE record<conversation>;
DEFINE FIELD sender ON TABLE message TYPE record<user>;
DEFINE FIELD recipient ON TABLE message TYPE record<user>;
DEFINE FIELD text ON TABLE message TYPE string ASSERT string::len($value) > 0 AND string::len($value) <= 2000;`,
      },
      {
        file: 'packages/schema/sp00ky.yml',
        lang: 'yaml',
        code: `clientTypes:
  - format: typescript
    output: ../../apps/solid-app/src/schema.gen.ts
  - format: dart
    output: ../../apps/flutter_app/lib/sync/app_db.g.dart`,
      },
    ],
  },
  {
    title: 'Read with a live query',
    body: [
      'The inbox is one query builder and one hook. The conversation rows arrive with both participants already joined, from the local cache first and then live.',
      'When a message lands on any device, the conversation\'s <code>last_message_ms</code> changes and the inbox re-sorts itself. The component has no idea a network exists.',
      'The web app has 178 of these <code>createQuery</code> call sites. Not one of them is paired with a refetch.',
    ],
    saved: 'No fetch calls, no cache keys, no invalidation after a write, no WebSocket client, no polling.',
    code: [
      {
        file: 'apps/solid-app/src/lib/query.ts',
        lang: 'ts',
        code: `export const qConversations = (db: Db) =>
  db
    .query("conversation")
    .related("user_a", (q: any) => q.select("id", "username", "email"))
    .related("user_b", (q: any) => q.select("id", "username", "email"))
    .build();`,
      },
      {
        file: 'apps/solid-app/src/components/messages/MessagesPage.jsx',
        lang: 'jsx',
        code: `const convQuery = createQuery(() => qConversations(db), {
  enabled: () => !!auth.userId(),
  deregisterOnCleanup: true,
});
const conversations = createMemo(() =>
  [...(convQuery.data() || [])].sort(
    (a, b) => (Number(b.last_message_ms) || 0) - (Number(a.last_message_ms) || 0),
  ),
);`,
      },
    ],
  },
  {
    title: 'Write locally, sync after',
    body: [
      'Sending a message is two writes: create the message, bump the conversation. Both land in the local store at once, so the bubble and the inbox preview appear before any network round trip.',
      'sp00ky sends the writes up in the background, retries them if the connection drops, and holds them in an outbox while the device is offline.',
    ],
    saved: 'No optimistic-update reducers, no rollback code, no offline queue, no "sending..." state machine.',
    code: [
      {
        file: 'apps/solid-app/src/lib/dm.js',
        lang: 'js',
        code: `await db.create(draft.id, {
  conversation: toRecordId(String(convId)),
  sender: toRecordId(String(myId)),
  recipient: toRecordId(String(peerId)),
  text: t,
  kind,
  created_ms: now,
  created_at: new Date(now).toISOString(),
  ...(opts.linkCount > 0 ? { link_count: opts.linkCount } : {}),
});
await db.update("conversation", String(convId), {
  last_message_text: String(opts.preview || t).slice(0, 120),
  last_message_ms: now,
  last_message_sender: toRecordId(String(myId)),
  last_message_kind: kind,
  [readField]: now,
});`,
      },
    ],
  },
  {
    title: 'Use the same data on iOS and Android',
    body: [
      'The Flutter app reads the same tables through sp00ky\'s Dart client. The conversation query is a line-for-line twin of the web one, and the models are generated from the same schema.',
      'Writes work the same way too: a typed <code>create</code> that shows up on the phone at once and on every other device a moment later.',
    ],
    saved: 'No second API client, no hand-written JSON mapping, no drift between what the web and the phone think a row looks like.',
    code: [
      {
        file: 'apps/flutter_app/lib/sync/MessagingService.dart',
        lang: 'dart',
        code: `static QueryBuilder conversationQuery(Sp00kyClient client) => client
    .query('conversation')
    .related(
      'user_a',
      (q) => q.select(const ['id', 'username', 'lichess_username']),
    )
    .related(
      'user_b',
      (q) => q.select(const ['id', 'username', 'lichess_username']),
    );`,
      },
      {
        file: 'apps/flutter_app/lib/sync/FriendshipService.dart',
        lang: 'dart',
        code: `await _spooky.db.friendship.create(Friendship(
  id: 'friendship:FS_\${customAlphabet(_idAlphabet, 7)}',
  requester: me,
  addressee: _fullUserId(otherId),
  status: statusPending,
  created_at: DateTime.now().toUtc(),
  created_ms: DateTime.now().millisecondsSinceEpoch,
));`,
      },
    ],
  },
  {
    title: 'Store files next to the rows that use them',
    body: [
      'Club crests, puzzle covers, broadcast art and stream recordings live in eight buckets, defined in the schema with their own permissions.',
      'Uploading is a hook and rendering is a component. The row only stores a key.',
    ],
    saved: 'No upload service, no signed-URL endpoint, no separate storage permissions to keep in line with the database.',
    code: [
      {
        file: 'packages/schema/src/buckets/puzzle_covers.surql',
        lang: 'surrealql',
        code: `DEFINE BUCKET IF NOT EXISTS puzzle_covers BACKEND "file:/buckets/puzzle_covers"
  PERMISSIONS WHERE $action IN ['get', 'head', 'exists']
    OR ($auth != NONE AND $action IN ['put', 'delete']);`,
      },
      {
        file: 'apps/solid-app/src/components/clubs/ClubSettingsDialog.jsx',
        lang: 'jsx',
        code: `const upload = useFileUpload("club_covers");
...
for (const [path, blob] of [
  [paths.full, full],
  [paths.thumb, thumb],
]) {
  await upload.upload(path, blob);
  const err = upload.error();
  if (err) throw err;
}
await updateClub(db, club().id, { [field]: key });

// ClubCrest.jsx
<BucketImage bucket="club_covers" path={path()} class="absolute inset-0" alt="" />`,
      },
    ],
  },
  {
    title: 'Describe background work instead of running it',
    body: [
      'WhitePawn imports every user\'s games from Lichess and Chess.com. That is one schedule: every minute, pick the connections that are due, call the sync backend once per connection, retry twice, and park a connection that keeps failing.',
      'The "Sync now" button enqueues the same job from the client. Engine analysis runs as a two-step workflow the same way, analyze first and then compute insights.',
      'The backend that does the importing is 1,138 lines of TypeScript. It does not schedule, queue or retry anything itself.',
    ],
    saved: 'No cron server, no queue, no worker fleet, no retry bookkeeping, no dashboard to find stuck jobs.',
    code: [
      {
        file: 'packages/schema/sp00ky.yml',
        lang: 'yaml',
        code: `schedules:
  game-sync:
    every: 1m
    backend: gamesync
    route: /syncGames
    forEach:
      query: >
        SELECT id FROM connection
        WHERE provider IN ['lichess', 'chesscom']
        AND sync_error = NONE
        AND (last_synced_at = NONE OR last_synced_at < time::now() - 15m)
        AND (sync_failed_at = NONE OR sync_failed_at < time::now() - 15m)
      key: id
    concurrency: skip
    retry:
      max: 2
      strategy: linear
    quarantineAfter: 5`,
      },
      {
        file: 'apps/solid-app/src/lib/gameSync.js',
        lang: 'js',
        code: `export async function pokeSync(db, connId) {
  await db.run(
    BACKEND,
    PATH,
    { connection: connId },
    { assignedTo: connId, delay: MANUAL_SYNC_DELAY_MS }
  );
}`,
      },
    ],
  },
  {
    title: 'Ship sixteen services with one command',
    body: [
      'Each service keeps a small <code>sp00ky.app.yml</code> next to its code. The root config pulls them together: the web app, thirteen backends in Go, TypeScript and Rust, a LiveKit server, and a pool of render machines that scales from zero to five while a livestream is on air.',
      '<code>spky deploy</code> builds the images, applies schema migrations and rolls the whole thing out to sp00ky cloud. Backups, logs and the admin dashboard come with it.',
    ],
    saved: 'No Kubernetes, no Terraform, no deploy scripts per service, no autoscaler of their own.',
    code: [
      {
        file: 'packages/schema/sp00ky.yml',
        lang: 'yaml',
        code: `apps:
  web:
    path: ../../apps/solid-app
  gamesync:
    path: ../../apps/gamesync-api
  gameanalysis:
    path: ../../apps/gameanalysis-api
  ...

pools:
  render:
    provider: hetzner
    machine: { type: cx33, fallbackTypes: [cx43, cpx32], locations: [fsn1, nbg1, hel1] }
    slots: 1
    min: 0
    autoscale: true
    max: 5
    idleTimeout: 1m
    recycle: job`,
      },
      {
        file: 'terminal',
        lang: 'bash',
        code: `spky deploy`,
      },
    ],
  },
];

// ---------------------------------------------------------------------------
// What a chess platform usually needs on the server, and what WhitePawn wrote.
// ---------------------------------------------------------------------------

const ledger: { would: string; got: string }[] = [
  { would: 'REST or GraphQL endpoints for every table', got: 'A <code>DEFINE TABLE</code> per table' },
  { would: 'Permission checks inside each handler', got: 'One <code>PERMISSIONS</code> clause, also applied to live queries' },
  { would: 'TypeScript and Dart models kept in step by hand', got: 'Two generated clients, 22,924 lines they never typed' },
  { would: 'A WebSocket server with reconnects and fan-out', got: '<code>createQuery</code> on the web, <code>.watch()</code> in Flutter' },
  { would: 'Client caching, refetching and invalidation', got: 'Nothing. Live queries do not go stale' },
  { would: 'An offline queue with retries', got: 'Local-first writes and a sync badge from <code>useSyncActivity</code>' },
  { would: 'A cron server and job queue for game imports', got: 'The <code>game-sync</code> schedule, 17 lines of YAML' },
  { would: 'Orchestration for multi-step engine analysis', got: 'The <code>game-cloud-analysis</code> workflow' },
  { would: 'An upload service with signed URLs', got: '<code>DEFINE BUCKET</code>, <code>useFileUpload</code>, <code>BucketImage</code>' },
  { would: 'A signaling server for voice and video calls', got: 'Rows in the <code>call</code> table' },
  { would: 'Deploy pipelines, an autoscaler and backups', got: '<code>spky deploy</code> and one <code>sp00ky.yml</code>' },
  { would: 'A secrets manager and an <code>.env</code> file per service', got: 'One shared vault, referenced by key name in each app' },
  { would: 'Runbooks, SSH sessions and log greps during incidents', got: 'The admin dashboard, and an MCP server agents can read' },
];

// ---------------------------------------------------------------------------
// The hub: secrets and agents. Key names only; no value appears anywhere here.
// Parsed from every apps/*/sp00ky.app.yml in WhitePawn (vault entries).
// ---------------------------------------------------------------------------

const vaultServices = ['relay', 'email', 'game server', 'MCP', 'analysis', 'commentator', 'recorder'];
const sharedSecrets: { key: string; note?: string; used: string[] }[] = [
  { key: 'SPKY_JWT_PUBLIC_KEY', used: ['relay', 'email', 'game server', 'MCP'] },
  { key: 'JWT_PRIVATE_KEY', used: ['email', 'MCP'] },
  { key: 'CEC_ANALYSIS_*', note: '4 keys', used: ['relay', 'analysis'] },
  { key: 'COMMENTATOR_SECRET', used: ['relay', 'commentator'] },
  { key: 'RECORDER_SECRET', used: ['relay', 'recorder'] },
  { key: 'BCAST_RENDER_SECRET', used: ['relay', 'recorder'] },
];

const onboarding = [
  {
    title: 'Invite',
    who: 'An admin',
    cmd: 'spky team invite dev@example.com',
    text: 'The admin\'s passphrase unlocks the vault key, and a re-encrypted copy travels with the invite. No value is sent to anyone.',
  },
  {
    title: 'Accept',
    who: 'The new developer',
    cmd: 'spky login',
    text: 'Sign in with GitHub, accept the invite and pick a personal passphrase. It never leaves the laptop.',
  },
  {
    title: 'Run',
    who: 'The new developer',
    cmd: 'spky dev',
    text: 'The whole stack starts from the dev values in each sp00ky.app.yml. Production secrets live in the cloud half of the config, so a laptop never holds one.',
  },
];

const mcpServers = [
  {
    name: 'Devtools',
    sees: 'The running app',
    what: 'Live queries, the local cache, auth state and the schema of an open tab. Runs SurrealQL locally or remotely.',
    tools: ['get_active_queries', 'describe_schema', 'run_query'],
  },
  {
    name: 'Cloud',
    sees: 'The account',
    what: 'Deployments, logs, environment variables, vault status, backups and domains. Secret values come back masked.',
    tools: ['deployment_status', 'logs_recent', 'env_list'],
  },
  {
    name: 'Admin',
    sees: 'The live cluster',
    what: 'Incidents, jobs with every attempt, schedules, workflow runs, live views and who is online. Restarts and backups with a write token.',
    tools: ['incidents_list', 'job_get', 'schedule_release'],
  },
];

// Reconstructed from the agent session on 2026-09-26 (whitepawn 20a0e285).
// Tool names are real; outputs are summarized, and player names are left out.
const transcript: { kind: 'event' | 'call' | 'out' | 'agent' | 'ship'; text: string }[] = [
  { kind: 'event', text: 'Incident open: schedule_quarantined on game-sync, 2 keys' },
  { kind: 'call', text: 'schedule_get("game-sync")' },
  { kind: 'out', text: '2 connections quarantined after 5 failures, since 09-24 and 09-26' },
  { kind: 'call', text: 'job_get(<last failed game-sync job>)' },
  { kind: 'out', text: 'last_error: Chess.com month fetch failed (404) for the current month' },
  { kind: 'agent', text: 'Chess.com\'s current-month archive answered 404 for a few minutes, then 200 again. A failed sync is re-selected on the next one-minute tick, so five failures took five minutes, and quarantine only ends with a release.' },
  { kind: 'call', text: 'schedule_release("game-sync", both keys)' },
  { kind: 'out', text: 'released, both connections synced on the next tick' },
  { kind: 'agent', text: 'Fix: stamp sync_failed_at on a transient failure and wait 15 minutes before the next try. The quarantine budget now spans more than an hour.' },
  { kind: 'ship', text: 'fix(gamesync): wait 15 minutes after a failed sync (20a0e285), deployed' },
];

const incidents = [
  {
    date: '3 Sep',
    read: ['workflow_run_get', 'logs_recent'],
    found: 'Every cloud-analysis run had failed at the insights step for days. The step showed no error; the reason was only in the sync processor\'s log: short games ending in mate could never reach the 90% coverage gate.',
    fix: 'Mate and stalemate positions are scored from the rules. The loop ends.',
  },
  {
    date: '14 Sep',
    read: ['overview', 'views_list', 'view_get', 'operations_list'],
    found: 'Short sync stalls traced to one table change republishing a whole window of a joined view: a 300-update transaction timing out.',
    fix: 'Fixes shipped upstream in sp00ky, plus a persistent incident history in the admin dashboard.',
  },
  {
    date: '20 Sep',
    read: ['incidents_list', 'jobs_list'],
    found: 'A deleted Chess.com account had cost a job every minute for 20 hours, hidden behind a failure counter that read zero.',
    fix: 'Four quiet faults fixed in sp00ky canary.267; quarantine switched on for game-sync.',
  },
  {
    date: '26 Sep',
    read: ['schedule_get', 'job_get', 'schedule_release'],
    found: 'Two accounts quarantined by a few minutes of 404s from Chess.com. One stayed stuck for two days.',
    fix: 'Released at once. Failed syncs now wait 15 minutes, and sp00ky re-probes quarantined keys on its own.',
  },
  {
    date: '27 Sep',
    read: ['incidents_list', 'job_get'],
    found: 'Six Lichess accounts quarantined for about 77 minutes each. Lichess allows two exports per account across every app a player uses.',
    fix: 'A 429 is now "busy, try in 15 minutes", never a failure.',
  },
];

// Commits per month to the WhitePawn monorepo (`git log`, HEAD and branches).
const months = [
  { label: 'Nov', commits: 14, milestone: true },
  { label: 'Dec', commits: 0 },
  { label: 'Jan', commits: 0 },
  { label: 'Feb', commits: 28 },
  { label: 'Mar', commits: 3, milestone: true },
  { label: 'Apr', commits: 5 },
  { label: 'May', commits: 50 },
  { label: 'Jun', commits: 113, milestone: true },
  { label: 'Jul', commits: 160, milestone: true },
  { label: 'Aug', commits: 98, milestone: true },
  { label: 'Sep', commits: 384, milestone: true },
];
const maxCommits = Math.max(...months.map((m) => m.commits));

const milestones = [
  {
    when: 'November 2025',
    what: 'The web app starts on sp00ky',
    detail: 'The first commit of the web app already reads its games through sp00ky. The games database and PGN import come first.',
  },
  {
    when: 'March 2026',
    what: 'One schema, one config file',
    detail: 'The schema and the backends move into sp00ky.yml, the one file that migrations and deploys run from.',
  },
  {
    when: 'June 2026',
    what: 'The Flutter app joins the same schema',
    detail: 'iOS, Android and macOS switch to sp00ky\'s Dart client. Landing the same month: puzzle builder, game comments, collection sharing, the livestream studio and analytics.',
  },
  {
    when: 'July 2026',
    what: 'Social, and background work',
    detail: 'Lichess and Chess.com sync, direct messages, friends, voice and video calls, and cloud game analysis with insights.',
  },
  {
    when: 'August 2026',
    what: 'Local-first boot',
    detail: 'Contacts ship, and the web app starts painting from its local cache before the network answers.',
  },
  {
    when: 'September 2026',
    what: 'The busiest month yet',
    detail: 'A puzzle store with ratings, paid plans, clubs with events, AI connectors for ChatGPT and Claude, and live play.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Unlisted while it is being proofread: no nav or footer link, kept out of
         search engines here and out of the site search by data-pagefind-ignore
         on <body>. Remove both, and add the links, to publish it. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>
    <meta property="og:type" content="article" />
    <meta property="og:url" content={new URL('customers/whitepawn', Astro.site)} />
    <meta property="og:title" content={`${title} | sp00ky`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | sp00ky`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL('/social-card.png', Astro.site)} />
    <title>{title} | sp00ky</title>
  </head>

  <body class="cs-page min-h-screen flex flex-col" data-pagefind-ignore="all">
    <SiteNav activePath="/customers" />

    <main class="cs flex-1">
      <!-- Hero -->
      <header class="cs-hero">
        <div class="cs-wrap">
          <nav class="cs-crumb" aria-label="Breadcrumb">
            <span>Customer story</span>
            <span aria-hidden="true">/</span>
            <a href="https://whitepawn.app" target="_blank" rel="noopener">WhitePawn</a>
          </nav>
          <h1>
            One developer runs a real-time chess platform.
            <span class="serif"><em>Without writing the plumbing.</em></span>
          </h1>
          <p class="cs-lede">
            WhitePawn gives people who own real chessboards one place to play, analyze, stream and
            meet: games, puzzles, clubs, messages, calls and live play on the web, iOS and Android.
            It is built by a single developer on sp00ky, with no API layer, no sync code and no
            ops team. sp00ky also keeps every secret and shows the running system to the AI agents
            that help build and operate it. Here is how.
          </p>
        </div>

        <figure class="cs-postcard">
          <Image
            src={heroArt}
            alt="Watercolor of a sunny terrace above a bay, with pairs of people playing chess at wooden tables."
            class="cs-postcard-art"
            widths={[768, 1280, 1536]}
            sizes="100vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
          <aside class="cs-facts" aria-label="WhitePawn at a glance">
            <div class="cs-facts-head">
              <svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"
                ><path
