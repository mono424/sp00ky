+DEFINE EVENT OVERWRITE statistics_enqueue ON TABLE game
+  WHEN ($event = "CREATE" OR $event = "DELETE" OR $event = "UPDATE") AND $sp00ky_endpoint != NONE AND ($after.owner ?? $before.owner) != user:scout AND NOT ($event != "DELETE" AND $after.status = "Recording" AND ($event = "CREATE" OR $before.status = "Recording"))
+  THEN {
+    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
+    LET $after_database = $after.database;
+    LET $bookkeeping = ["insights_computed_at", "insights_error", "insights_attempts", "insights_next_attempt_at", "cloud_analysis_held_until"];
+    IF $event = "UPDATE" AND object::remove($before, $bookkeeping) = object::remove($after, $bookkeeping) {
+      IF ($before.insights_computed_at = NONE) != ($after.insights_computed_at = NONE) {
+        LET $n = (SELECT VALUE count() FROM game WHERE database = $after_database AND insights_computed_at != NONE GROUP ALL)[0] ?? 0;
+        UPDATE (SELECT VALUE id FROM statistics WHERE database = $after_database) SET analyzed_count = $n;
+      };
+    } ELSE {
+      -- A game deleted after its collection or its account is already gone (the
+      -- paced /cleanup-collection and /cleanup-account jobs in apps/analytics-api)
+      -- has nothing left to recompute: the aggregates die with the collection.
+      -- Before this guard, deleting a large collection queued one full recompute
+      -- of the dead collection per deleted game. An IF/THEN expression, so
+      -- record::exists never sees the NONE $before of a CREATE: a function error
+      -- inside this event aborts the game write.
+      LET $gone = IF $event = "DELETE" THEN (!record::exists($before.database) OR !record::exists($before.owner)) ELSE false END;
+      IF !$gone {
+        LET $bd = IF $event != "CREATE" THEN $before.database ELSE NONE END;
+        LET $ad = IF $event != "DELETE" THEN $after.database ELSE NONE END;
+        FOR $coll IN array::distinct([$bd, $ad]) {
+          IF $coll != NONE {
+            IF array::len(SELECT VALUE id FROM statistics_job WHERE assigned_to = $coll AND status = "pending" AND payload.contacts != true) = 0 {
+              CREATE statistics_job CONTENT {
+                assigned_to: $coll,
+                path: "/recompute",
+                payload: { database: <string> $coll },
+                status: "pending"
+              };
+            };
+          };
+        };
+      };
+    };
+  }
+;
