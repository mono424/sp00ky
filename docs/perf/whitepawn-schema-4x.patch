+-- Single-column indexes for the lookups the events above make: inside an event
+-- body SurrealDB 4.0.1 does not use a composite index for a parameter, whichever
+-- of its columns the WHERE matches. Built concurrently: analysis holds millions of rows.
+DEFINE INDEX IF NOT EXISTS analysis_game ON TABLE analysis FIELDS game CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS statistics_database ON TABLE statistics FIELDS database CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS notification_recipient ON TABLE notification FIELDS recipient CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS database_players_club ON TABLE database_players FIELDS club CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS statistics_owner ON TABLE statistics FIELDS owner CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS collection_share_collection ON TABLE collection_share FIELDS collection CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS activity_day_database ON TABLE activity_day FIELDS database CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS puzzle_lecture_puzzle ON TABLE puzzle_lecture FIELDS puzzle CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS broadcast_share_broadcast ON TABLE broadcast_share FIELDS broadcast CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS broadcast_eval_broadcast ON TABLE broadcast_eval FIELDS broadcast CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS stream_recording_segment_by_recording ON TABLE stream_recording_segment FIELDS recording CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS stream_recording_part_by_recording ON TABLE stream_recording_part FIELDS recording CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS club_event_club ON TABLE club_event FIELDS club CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS club_post_club ON TABLE club_post FIELDS club CONCURRENTLY;
+DEFINE INDEX IF NOT EXISTS club_post_comment_post ON TABLE club_post_comment FIELDS post CONCURRENTLY;
+
+-- `FOR select WHERE true` is the same rule as `FOR select FULL`, but SurrealDB 4.0.1
+-- plans the two differently for a record user: with any select rule other than FULL
+-- it gives up the table's indexes for a query the user's write runs through an event
+-- (a game delete by its owner read all 11.45M analysis rows: 37-115 s; 0.2-0.5 s with
+-- FULL), and with a non-FULL rule on a filtered field even for the user's own query.
+
+DEFINE TABLE OVERWRITE user SCHEMAFULL
+PERMISSIONS
+  FOR update, delete, create WHERE $access IN ["account", "_00_impersonate"] AND id = $auth.id AND ($auth.session_epoch = NONE OR ($token.iat ?? 0) >= $auth.session_epoch)
+  FOR select FULL;
+
+DEFINE FIELD OVERWRITE email ON TABLE user TYPE string
+ASSERT $value != NONE -- AND string::is_email($value) -- NOT COMPATIBLE RIGHT NOW
+PERMISSIONS
+    FOR select FULL
+    FOR update WHERE $access = "account" AND id = $auth.id;
+
+DEFINE FIELD OVERWRITE public_key ON TABLE user TYPE option<string> PERMISSIONS FOR select FULL FOR create, update WHERE false;
+
+DEFINE FIELD OVERWRITE plan ON TABLE user TYPE option<string> PERMISSIONS FOR select FULL FOR update WHERE false;
+
+DEFINE TABLE OVERWRITE game_database SCHEMAFULL
+  PERMISSIONS
+    FOR select FULL
+    FOR create, delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
+    FOR update WHERE $access IN ["account", "_00_impersonate"] AND ( owner = $auth.id OR id IN (SELECT VALUE collection FROM collection_share WHERE user = $auth.id AND role = 'editor') OR club IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) )
+;
+
+DEFINE TABLE OVERWRITE game SCHEMAFULL
+  PERMISSIONS
+    FOR select FULL
+    FOR update, delete, create WHERE $access IN ["account", "_00_impersonate"] AND ( owner = $auth.id OR database.owner = $auth.id OR database IN (SELECT VALUE collection FROM collection_share WHERE user = $auth.id AND role = 'editor') )
+;
+
+DEFINE FIELD OVERWRITE skins ON TABLE game TYPE option<array<string>> PERMISSIONS FOR select FULL FOR create, update WHERE $access NOT IN ["account", "_00_impersonate"] OR $value = NONE OR array::len(array::complement(array::distinct($value.map(|$e| string::split($e, ":")[1])), (SELECT VALUE skin FROM piece_skin WHERE owner = $auth.id))) = 0;
+
+DEFINE TABLE OVERWRITE puzzle SCHEMAFULL
+  PERMISSIONS
