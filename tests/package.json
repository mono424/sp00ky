{
  "name": "@spooky-sync/tests",
  "version": "0.0.1-canary.243",
  "private": true,
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "generate": "pnpm run generate:client && pnpm run generate:remote",
    "generate:client": "spooky --input ../example/schema/src/schema.surql --output .sp00ky/client_schema.ts",
    "generate:remote": "spooky --input ../example/schema/src/schema.surql --output .sp00ky/schema.gen.surql --modules-dir ../packages/surrealism-modules"
  },
  "devDependencies": {
    "@spooky-sync/cli": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "surrealdb": "2.0.3",
    "testcontainers": "^11.10.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
