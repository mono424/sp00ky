DEFINE FIELD OVERWRITE data ON TABLE message_link TYPE option<string> PERMISSIONS FOR select, update FULL FOR create WHERE false;

DEFINE FIELD OVERWRITE error ON TABLE message_link TYPE option<string> PERMISSIONS FOR select, update FULL FOR create WHERE false;

DEFINE FIELD OVERWRITE attempts ON TABLE message_link TYPE option<int> PERMISSIONS FOR select, update FULL FOR create WHERE false;

DEFINE FIELD OVERWRITE fetched_at ON TABLE message_link TYPE option<datetime> PERMISSIONS FOR select, update FULL FOR create WHERE false;

DEFINE TABLE OVERWRITE play_rating SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete NONE
;

DEFINE TABLE OVERWRITE app_release SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE false
;

DEFINE TABLE OVERWRITE club SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
    FOR update WHERE $access IN ["account", "_00_impersonate"] AND ( owner = $auth.id OR id IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) )
;

DEFINE TABLE OVERWRITE club_member SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create WHERE $access IN ["account", "_00_impersonate"] AND ( ( user = $auth.id AND accepted = true AND approved = false AND role = 'member' AND club.visibility = 'public' ) OR ( accepted = false AND approved = true AND ( club.owner = $auth.id OR club IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) ) ) )
    FOR update WHERE $access IN ["account", "_00_impersonate"] AND ( user = $auth.id OR club.owner = $auth.id OR club IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) )
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND ( user = $auth.id OR club.owner = $auth.id OR club IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) )
;

DEFINE TABLE OVERWRITE club_event SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE $access IN ["account", "_00_impersonate"] AND ( club.owner = $auth.id OR club IN (SELECT VALUE club FROM club_member WHERE user = $auth.id AND role = 'admin' AND approved = true AND accepted = true) )
;

DEFINE TABLE OVERWRITE commented_on SCHEMAFULL TYPE RELATION
  FROM comment TO game
  PERMISSIONS FOR select FULL;

