---
import { docsNav as nav, resolveActive } from '../config/nav';

const { link: activeLink } = resolveActive(Astro.url.pathname);
---

<nav class="docs-sidebar" aria-label="Documentation">
  {
    nav.map((group) => (
      <section class="docs-sidebar-group">
        <p class="docs-sidebar-title">{group.title}</p>
        <ul>
          {group.links.map((link) => {
            const isActive = link === activeLink;
            return (
              <li>
                <a
                  href={link.href}
                  class="docs-sidebar-link"
                  aria-current={isActive ? 'page' : undefined}
                  data-sidebar-active={isActive ? '' : undefined}
                >
                  <span class="truncate">{link.text}</span>
                  {link.experimental && (
                    <svg
                      class="docs-sidebar-experimental"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      viewBox="0 0 24 24"
                      role="img"
                      aria-label="Experimental"
                    >
                      <title>Experimental</title>
                      <path d="M9 3h6" />
                      <path d="M10 3v6.5L4.5 19a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L14 9.5V3" />
                      <path d="M7 14h10" />
                    </svg>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</nav>
