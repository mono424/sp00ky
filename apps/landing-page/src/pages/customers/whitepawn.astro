    <SiteFooter />

    <script>
      // Scroll-linked walkthrough: the step nearest the middle of the viewport is
      // active, and its code shows in the sticky column. Narrow screens show the
      // code inline under each step instead, so they skip this.
      const root = document.querySelector<HTMLElement>('[data-steps]');
      const wide = window.matchMedia('(min-width: 901px)');
      if (root) {
        const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
        const codes = [...root.querySelectorAll<HTMLElement>('[data-code]')];
        const activate = (i: number) => {
          steps.forEach((s, j) => s.classList.toggle('is-active', i === j));
          codes.forEach((c, j) => c.classList.toggle('is-active', i === j));
        };
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) activate(Number((entry.target as HTMLElement).dataset.step));
            }
          },
          { rootMargin: '-45% 0px -50% 0px' },
        );
        const sync = () => {
          root.classList.toggle('is-enhanced', wide.matches);
          steps.forEach((s) => (wide.matches ? observer.observe(s) : observer.unobserve(s)));
        };
        sync();
        wide.addEventListener('change', sync);
      }
    </script>
  </body>
