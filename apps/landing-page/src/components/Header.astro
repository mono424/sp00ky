---
import GitHubStars from './GitHubStars';
import { Search } from './Search';
---

<header
  class="h-16 border-b border-white/[0.06] bg-background/75 backdrop-blur-xl backdrop-saturate-150 sticky top-0 z-50"
>
  <div class="max-w-[1600px] mx-auto h-full flex items-center justify-between px-6">
    <div class="flex items-center gap-4">
      <button
        id="mobile-menu-trigger"
        class="lg:hidden p-2 -ml-2 text-text-muted hover:text-text-primary hover:bg-white/[0.06] rounded-lg transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <img src="/logo.svg" alt="sp00ky Logo" class="h-6" />
      </a>
    </div>

    <div>
      <Search client:idle />
    </div>

    <div class="flex items-center gap-4 text-sm text-text-muted">
      <GitHubStars client:load />
    </div>
  </div>
</header>
