---
// One layer of the "How it works" stack: a line sketch from
// scripts/architecture-sketches.py with the real logos projected onto its top
// face. The sketches share one slab and camera, so these positions
// (architecture.css, `.plan-*-logo`) hold for all three.
interface Props {
  id: 'client' | 'database' | 'engine';
  index?: number;
}
const { id, index } = Astro.props;
const asset = (name: string) => `${import.meta.env.BASE_URL}${name}`;
const logo = id === 'database' ? 'surrealdb-logo.png' : 'footer-mark-00.svg';
---
<div class:list={['plan-layer', `plan-layer-${id}`, { 'is-active': index === 0 }]} data-plan-layer={index}>
  <img src={asset(`architecture/${id}.svg`)} alt="" width="1536" height="1024" loading="lazy" decoding="async" class="plan-layer-art" />
  <img src={asset(logo)} alt="" class="plan-surface-logo" width="100" height="100" />
  {id === 'engine' && [0, 1, 2, 3].map((chip) => <img src={asset('footer-mark-00.svg')} alt="" class={`plan-chip-logo plan-chip-${chip}`} width="40" height="26" />)}
</div>
