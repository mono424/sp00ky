;

DEFINE EVENT OVERWRITE club_post_comment_visibility_mirror ON TABLE club_post
  WHEN $event = "UPDATE" AND $before.visibility != $after.visibility AND $sp00ky_endpoint != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
