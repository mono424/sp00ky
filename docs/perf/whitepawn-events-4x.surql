DEFINE FIELD OVERWRITE url ON TABLE camera_ingest TYPE option<string> PERMISSIONS FOR select FULL FOR create, update WHERE false;

DEFINE FIELD OVERWRITE stream_key ON TABLE camera_ingest TYPE option<string> PERMISSIONS FOR select FULL FOR create, update WHERE false;

DEFINE FIELD OVERWRITE participant_identity ON TABLE camera_ingest TYPE option<string> PERMISSIONS FOR select FULL FOR create, update WHERE false;

