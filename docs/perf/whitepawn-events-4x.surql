DEFINE TABLE OVERWRITE comment SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR update, delete, create WHERE $access IN ["account", "_00_impersonate"] AND author.id = $auth.id
;

DEFINE TABLE OVERWRITE branch SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
    FOR create, update WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id AND ( game.database.owner = $auth.id OR game.database IN (SELECT VALUE collection FROM collection_share WHERE user = $auth.id AND role = 'editor') )
;

DEFINE TABLE OVERWRITE annotation SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE $access IN ["account", "_00_impersonate"] AND ( game.database.owner = $auth.id OR game.database IN (SELECT VALUE collection FROM collection_share WHERE user = $auth.id AND role = 'editor') )
;

DEFINE TABLE OVERWRITE analysis SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
    FOR create, update WHERE $access IN ["account", "_00_impersonate"] AND owner = $auth.id
;

DEFINE TABLE OVERWRITE game_insight SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update, delete WHERE false
;

DEFINE TABLE OVERWRITE collection_share SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update WHERE $access IN ["account", "_00_impersonate"] AND collection.owner = $auth.id
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND ( user = $auth.id OR collection.owner = $auth.id )
;

DEFINE FIELD OVERWRITE mcp_client_name ON TABLE collection_share TYPE option<string> PERMISSIONS FOR select FULL FOR create, update WHERE false;

DEFINE TABLE OVERWRITE puzzle_rating SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create WHERE $access IN ["account", "_00_impersonate"] AND user = $auth.id
    FOR update WHERE $access IN ["account", "_00_impersonate"] AND user = $auth.id
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND user = $auth.id
;

DEFINE FIELD OVERWRITE reply_count ON TABLE puzzle_rating TYPE option<int> PERMISSIONS FOR select FULL FOR create, update WHERE false;

DEFINE TABLE OVERWRITE puzzle_rating_reply SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create WHERE $access IN ["account", "_00_impersonate"] AND user = $auth.id AND puzzle = rating.puzzle AND (rating.user = $auth.id OR rating.puzzle.owner = $auth.id)
    FOR update WHERE false
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND user = $auth.id
;

DEFINE TABLE OVERWRITE broadcast_share SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create, update WHERE $access IN ["account", "_00_impersonate"] AND broadcast.owner = $auth.id
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND ( user = $auth.id OR broadcast.owner = $auth.id )
;

DEFINE TABLE OVERWRITE chat_message SCHEMAFULL
  PERMISSIONS
    FOR select FULL
    FOR create WHERE $access IN ["account", "_00_impersonate"] AND user = $auth.id
    FOR update WHERE false
    FOR delete WHERE $access IN ["account", "_00_impersonate"] AND ( user = $auth.id OR broadcast.owner = $auth.id OR broadcast IN (SELECT VALUE broadcast FROM broadcast_share WHERE user = $auth.id AND role = 'admin') )
;

DEFINE FIELD OVERWRITE provider ON TABLE message_link TYPE option<string> PERMISSIONS FOR select, update FULL FOR create WHERE false;

DEFINE FIELD OVERWRITE link_kind ON TABLE message_link TYPE option<string> PERMISSIONS FOR select, update FULL FOR create WHERE false;

DEFINE FIELD OVERWRITE title ON TABLE message_link TYPE option<string> PERMISSIONS FOR select, update FULL FOR create WHERE false;

DEFINE FIELD OVERWRITE description ON TABLE message_link TYPE option<string> PERMISSIONS FOR select, update FULL FOR create WHERE false;

