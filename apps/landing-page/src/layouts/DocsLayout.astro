---
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import OnThisPage from '../components/OnThisPage.astro';
import Header from '../components/Header.astro';
import NextSteps from '../components/ui/NextSteps.astro';
import { basePath, resolveActive } from '../config/nav';
// oxlint-disable-next-line no-unassigned-import
import '../styles/docs.css';

const { frontmatter, headings } = Astro.props;
const title = frontmatter?.title || Astro.props.title;
// One-line page summary. Rendered as the lead paragraph and reused for social
// cards, so a page that sets it gets a useful preview instead of the generic one.
const description = frontmatter?.description || Astro.props.description;
const socialDescription =
  description || 'sp00ky documentation, The Reactive, Local-First Framework for SurrealDB';

const { group: activeGroup } = resolveActive(Astro.url.pathname);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} | sp00ky Docs`} />
    <meta name="description" content={socialDescription} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | sp00ky Docs`} />
    <meta property="twitter:description" content={socialDescription} />
    <meta property="twitter:image" content={new URL('/social-card.png', Astro.site)} />
    <title>{title} | sp00ky Docs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link rel="help" type="text/markdown" href="/llm.txt" title="LLM Info" />
    <script>
      import mermaid from 'mermaid';
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        fontFamily: 'Inter, sans-serif',
        themeVariables: {
          background: 'transparent',
          primaryColor: '#17171a',
          primaryTextColor: '#f4f4f5',
          primaryBorderColor: 'rgba(255,255,255,0.14)',
          secondaryColor: '#1d1d21',
          secondaryTextColor: '#f4f4f5',
          secondaryBorderColor: 'rgba(255,255,255,0.1)',
          tertiaryColor: 'rgba(255,255,255,0.03)',
          tertiaryTextColor: '#a1a1aa',
          tertiaryBorderColor: 'rgba(255,255,255,0.08)',
          clusterBkg: 'rgba(255,255,255,0.03)',
          clusterBorder: 'rgba(255,255,255,0.08)',
          lineColor: '#9b8aff',
          textColor: '#f4f4f5',
          mainBkg: '#17171a',
          nodeBorder: 'rgba(255,255,255,0.14)',
          edgeLabelBackground: '#101012',
          actorBkg: '#17171a',
          actorBorder: 'rgba(255,255,255,0.14)',
          actorTextColor: '#f4f4f5',
          signalColor: '#9b8aff',
          signalTextColor: '#f4f4f5',
          labelBoxBkgColor: '#17171a',
          labelBoxBorderColor: 'rgba(255,255,255,0.14)',
          noteBkgColor: 'rgba(124,106,239,0.12)',
          noteBorderColor: 'rgba(155,138,255,0.3)',
          noteTextColor: '#f4f4f5',
        },
      });

      async function renderMermaid() {
        // Query ALL code blocks to be safe
        const graphs = document.querySelectorAll('pre > code');

        for (const graph of graphs) {
          const content = graph.textContent;
          if (!content) continue;

          let isMermaid = false;

          // 1. Explicit class check
          if (graph.classList.contains('language-mermaid')) {
            isMermaid = true;
          }
          // 2. Content Heuristic (if no explicit class or generic text class)
          else {
            const trimmed = content.trim();
            if (
              trimmed.startsWith('graph') ||
              trimmed.startsWith('sequenceDiagram') ||
              trimmed.startsWith('classDiagram') ||
              trimmed.startsWith('erDiagram') ||
              trimmed.startsWith('stateDiagram') ||
              trimmed.startsWith('pie') ||
              trimmed.startsWith('%%{init:')
            ) {
              isMermaid = true;
            }
          }

          if (!isMermaid) continue;

          const pre = graph.parentElement;
          if (!pre) continue;

          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = content;

          pre.replaceWith(div);
        }
        await mermaid.run();
      }

      document.addEventListener('astro:page-load', renderMermaid);
      // Also run on initial load if view transitions aren't active or for first render
      renderMermaid();
    </script>
    <ClientRouter />
  </head>
  <body
    transition:name="root"
    transition:animate="none"
    class="bg-background text-text-secondary antialiased selection:bg-brand-500/30"
  >
    <Header transition:persist />

    <div class="max-w-[1600px] mx-auto flex w-full min-h-screen">
      <aside class="docs-rail hidden lg:block w-[272px] shrink-0 border-r border-white/[0.06]">
        <div class="docs-rail-scroll pt-8 pb-16 pl-6 pr-5" data-sidebar-scroller>
          <Sidebar />
        </div>
      </aside>

      <main class="flex-1 min-w-0 pt-8 pb-16 px-6 lg:px-12">
        <div class="prose prose-invert prose-docs max-w-3xl w-full">
          <nav
            class="not-prose flex items-center gap-1.5 text-[13px] text-zinc-500 mb-5 overflow-x-auto whitespace-nowrap"
            aria-label="Breadcrumb"
          >
            <a href={`${basePath}/docs`} class="hover:text-zinc-200 transition-colors">Docs</a>
            {
              activeGroup && (
                <>
                  <svg
                    class="h-3.5 w-3.5 shrink-0 text-zinc-700"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                  <span class="text-zinc-400">{activeGroup.title}</span>
                </>
              )
            }
          </nav>

          <h1
            class:list={[
              'text-4xl font-semibold tracking-tight',
              description ? 'mb-4' : 'mb-8',
            ]}
          >
            {title}
          </h1>
          {
            description && (
              <p class="text-lg text-text-muted leading-relaxed mb-8">{description}</p>
            )
          }

          <slot />

          <NextSteps />
        </div>
      </main>

      <aside class="docs-rail hidden xl:block w-[248px] shrink-0">
        <div class="docs-rail-scroll pt-8 pb-16 pl-2 pr-6" data-toc-scroller>
          <OnThisPage headings={headings} />
        </div>
      </aside>

      <!-- Mobile Menu Overlay -->
      <div
        id="mobile-menu"
        class="fixed inset-x-0 bottom-0 top-16 z-40 bg-black/50 backdrop-blur-md lg:hidden hidden"
      >
        <div
          class="h-full w-[85%] max-w-[320px] overflow-y-auto overscroll-contain border-r border-white/[0.08] bg-[#0c0c0e] px-6 pb-12 pt-4 shadow-glass-lg [scrollbar-width:none]"
        >
          <div class="flex justify-end mb-2 -mr-2">
            <button
              id="mobile-menu-close"
              aria-label="Close menu"
              class="p-2 text-text-muted hover:text-text-primary hover:bg-white/[0.06] rounded-lg transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <Sidebar />
        </div>
      </div>
    </div>

    <script>
      // Scripts run once, but ClientRouter swaps the body on every navigation, so
      // anything bound to page elements has to be re-bound on `astro:page-load`.
      let sidebarScroll: number | undefined;

      document.addEventListener('astro:before-swap', () => {
        sidebarScroll = document.querySelector('[data-sidebar-scroller]')?.scrollTop;
      });

      document.addEventListener('astro:page-load', () => {
        // Keep the sidebar where the reader left it, and only move it when the
        // current page's entry would otherwise be out of sight.
        const scroller = document.querySelector<HTMLElement>('[data-sidebar-scroller]');
        const active = scroller?.querySelector<HTMLElement>('[data-sidebar-active]');
        if (scroller) {
          if (sidebarScroll !== undefined) scroller.scrollTop = sidebarScroll;
          if (active) {
            const box = scroller.getBoundingClientRect();
            const link = active.getBoundingClientRect();
            if (link.top < box.top + 32 || link.bottom > box.bottom - 32) {
              scroller.scrollTop += link.top - box.top - box.height / 2 + link.height / 2;
            }
          }
        }

        const trigger = document.getElementById('mobile-menu-trigger');
        const closeBtn = document.getElementById('mobile-menu-close');
        const menu = document.getElementById('mobile-menu');
        if (!menu) return;

        const setOpen = (open: boolean) => {
          menu.classList.toggle('hidden', !open);
          document.body.style.overflow = open ? 'hidden' : '';
          trigger?.setAttribute('aria-expanded', String(open));
        };

        setOpen(false);
        trigger?.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
        closeBtn?.addEventListener('click', () => setOpen(false));
        // Tapping the dimmed area outside the sheet closes the drawer
        menu.addEventListener('click', (e) => {
          if (e.target === menu) setOpen(false);
        });
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
      });
    </script>
  </body>
</html>
