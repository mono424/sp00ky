;

DEFINE EVENT OVERWRITE collection_links_cleanup ON TABLE game_database
  WHEN $event = "DELETE" AND $sp00ky_endpoint != NONE
  THEN {
    -- Bound first: SurrealDB 4.0.1 scans for a WHERE on $before/$after inside an event body.
    LET $before_id = $before.id;
    DELETE (SELECT VALUE id FROM collection_share WHERE collection = $before_id);
    DELETE (SELECT VALUE id FROM connection WHERE collection = $before_id);
